<Project>

  <!--
    Central Package Management: a versão de cada pacote é declarada uma única vez, aqui.
  -->

  <!--
    Componentes TEC.* consumidos: versão PUBLICADA no feed tec-interno (todos os pacotes de um componente têm a mesma
    versão). No csproj use <TecReference Include="TEC.X" />, sem versão: vira PackageReference nesta versão, na máquina
    e no CI; o projeto vizinho só entra com -p:TecUseLocalProjects=true (build/Tec.Build.targets).
  -->
  <ItemGroup>
    <PackageVersion Include="TEC.Core" Version="0.0.1" />
    <PackageVersion Include="TEC.Cqrs" Version="0.0.1" />
    <PackageVersion Include="TEC.Vault" Version="0.0.1" />
    <PackageVersion Include="TEC.Vault.AzureKeyVault" Version="0.0.1" />
    <PackageVersion Include="TEC.Vault.InMemory" Version="0.0.1" />
  </ItemGroup>

  <!-- Terceiros -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="FsCheck" Version="3.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <!--
      Roslyn: o gerador compila contra o 4.12 (menor versão de compilador que ele suporta: SDK 9.0.1xx / VS 17.12).
      Testes e benchmarks precisam de um Roslyn mais novo (EF Core Design 10 exige 5.0; BenchmarkDotNet, 4.14) e, com a
      fixação transitiva ligada, um 4.12 central seria um downgrade (NU1109).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" Condition="'$(MSBuildProjectName)' == 'TEC.ORM.Mapping.Generator'" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" Condition="'$(MSBuildProjectName)' != 'TEC.ORM.Mapping.Generator'" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <PackageVersion Include="TUnit" Version="1.76.0" />
  </ItemGroup>

  <!-- EF Core e provedores acompanham o .NET do alvo (net10.0 -> EF Core 10) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Oracle.EntityFrameworkCore" Version="10.23.26400" />
  </ItemGroup>

  <!--
    Fixações de transitivos vulneráveis (CentralPackageTransitivePinningEnabled no build/Tec.Build.props): a versão
    declarada aqui vence a que a árvore de dependências traria.
  -->
  <ItemGroup>
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
