<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source generator do mapeamento entidade ↔ DTO. Não é publicado sozinho: vai dentro do pacote TEC.ORM
    (analyzers/dotnet/cs), então quem instala o TEC.ORM já tem a geração ligada.
    netstandard2.0: exigência do Roslyn para rodar no compilador (dotnet build e Visual Studio).
  -->

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <RootNamespace>TEC.ORM.Mapping.Generator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Analisadores do .NET com as regras de segurança, como nos pacotes -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;RS1035;RS1036;RS1038;RS1041</WarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Acompanhamento de versão das regras TECORMxxx (RS2008) -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TEC.ORM.Tests" />
  </ItemGroup>

</Project>
