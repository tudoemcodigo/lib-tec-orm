<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Micro-benchmarks (BenchmarkDotNet): tempo e alocação das operações do TEC.ORM e o custo dele em relação ao EF Core puro
    (provedor InMemory: mede o código do ORM, não o banco). Rodam sob demanda, sempre em Release (veja docs/testes.md): não
    fazem parte do dotnet test. Framework, lock file e auditoria de pacotes em ../Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- BenchmarkDotNet gera e compila um projeto por benchmark: símbolos completos e otimização obrigatórios -->
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Versão por runtime (8.0.x no net8.0, 10.0.x no net10.0) definida no Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gerador do mapeamento: DTOs dos benchmarks de projeção e conversão -->
    <ProjectReference Include="..\TEC.ORM.Mapping.Generator\TEC.ORM.Mapping.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TEC.ORM.SqlServer\TEC.ORM.SqlServer.csproj" />
    <TecReference Include="TEC.Vault.InMemory" />
  </ItemGroup>

</Project>
