<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TEC.ORM.PostgreSql</RootNamespace>
    <Description>Provedor PostgreSQL para o TEC.ORM com Entity Framework Core e Dapper: conexão segura do cofre, isolamento de dialeto e resiliência.</Description>
    <PackageTags>orm;postgresql;npgsql;entityframework;dapper;vault;opentelemetry;tec</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.ORM.EntityFrameworkCore\TEC.ORM.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
