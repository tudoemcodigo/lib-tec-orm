<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TEC.ORM.MySql</RootNamespace>
    <Description>Provedor MySQL / MariaDB para o TEC.ORM com Entity Framework Core e Dapper: conexão segura do cofre, isolamento de dialeto e resiliência.</Description>
    <PackageTags>orm;mysql;mariadb;entityframework;dapper;vault;opentelemetry;tec</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!--
    EF Core: MySql.EntityFrameworkCore (Oracle), o provedor com versão para o EF Core 10 (o Pomelo não tem). Ele usa o driver
    MySql.Data, que vem junto e é o mesmo usado pelo Dapper: uma string de conexão só, aceita pelos dois caminhos (o
    MySqlConnector recusava chaves que o MySql.Data não aceita, como Application Name).
  -->
  <ItemGroup>
    <PackageReference Include="MySql.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.ORM.EntityFrameworkCore\TEC.ORM.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
